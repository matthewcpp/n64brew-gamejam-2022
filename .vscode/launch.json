{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug Asset Pipeline",
            "program": "${workspaceFolder}/lib/framework64/scripts/PrepareGameAssets.js",
            "request": "launch",
            "skipFiles": [
                "<node_internals>/**"
            ],
            "type": "node",
            "args":["desktop"]
        },
        {
            "name": "GDB Debug Rom",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build_n64_libultra/src/dead_ritual.elf",
            "cwd": "${workspaceRoot}",
            "MIMode": "gdb",
            "miDebuggerPath": "gdb-multiarch",
            "miDebuggerServerAddress": "host.docker.internal:8080", // enable for Windows / Mac
            // "miDebuggerServerAddress": "localhost:8080", // enable for Linux
            "setupCommands": [{
                "text": "set arch mips:4300"
            }]
        }
    ]
}